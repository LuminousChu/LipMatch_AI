     "expect": {"liked_finishes": [], "disliked_finishes": ["matte"], "conflicts": 0}},
    {"id": "P09", "spec": "§2", "title": "「改成霧面」是明確取代：移除排斥、設為喜好",
     "steps": ["不要霧面", "改成霧面"],
     "expect": {"liked_finishes": ["matte"], "disliked_finishes": [], "conflicts": 0}},
    {"id": "P10", "spec": "R01", "title": "小麥色只記原話，不推定暖底調",
     "steps": ["我是小麥色，推薦唇彩"],
     "expect": {"skin_tone": "小麥色", "undertone": null, "blocking_questions": 0, "max_questions": 1, "last_intent": "recommend"}},
    {"id": "P11", "spec": "R07", "title": "「不要太紅」不排除紅色，先澄清",
     "steps": ["不要太紅"],
     "expect": {"disliked_colors": [], "ambiguities": 1, "blocking_questions": 1}},
    {"id": "P12", "spec": "R07", "title": "回答「不要太鮮豔」後模糊詞解除，仍不排除紅色",
     "steps": ["不要太紅", "我是說不要太鮮豔"],
     "expect": {"disliked_colors": [], "avoided_effects": ["vivid"], "ambiguities": 0}},
    {"id": "P13", "spec": "§2", "title": "已知過敏記錄需避開項目",
