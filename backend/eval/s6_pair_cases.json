     "expect": {"max_questions": 0}},
    {"id": "P22", "spec": "R08", "title": "比較問題提到的色系不寫成偏好",
     "steps": ["豆沙色和玫瑰色差在哪"],
     "expect": {"liked_colors": [], "last_intent": "compare"}},
    {"id": "P23", "spec": "§1", "title": "知識問答提到膚色不當成自述",
     "steps": ["小麥色是什麼意思"],
     "expect": {"skin_tone": null, "last_intent": "knowledge"}},
    {"id": "P24", "spec": "R16", "title": "「水潤」保留原詞，外觀與保濕待確認（非阻斷）",
     "steps": ["想要水潤的唇色"],
     "expect": {"effects": ["moist"], "ambiguities": 1, "blocking_questions": 0, "max_questions": 1}},
    {"id": "P25", "spec": "§2", "title": "使用者明說底調才記錄",
     "steps": ["我是冷底"],
     "expect": {"undertone": "cool"}},
    {"id": "P26", "spec": "§1", "title": "照片判讀屬範圍外",
     "steps": ["可以看我的照片幫我選色嗎"],
     "expect": {"last_intent": "outside_scope", "limitation_contains": "照片"}}
