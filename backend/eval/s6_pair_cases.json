     "expect": {"occasion": null, "occasion_status": "user", "occasion_values": ["office", "party"],
                "conflicts": 0, "blocking_questions": 0}},
    {"id": "P18", "spec": "R10", "title": "預算只記錄；商品功能未啟用要揭露",
