     "steps": ["上班用的唇色，不要霧面", "改成聚會"],
     "expect": {"occasion": "party", "occasion_status": "user", "disliked_finishes": ["matte"], "liked_finishes": [], "conflicts": 0, "last_intent": "update"}},
    {"id": "P02", "spec": "R06", "title": "取消不要霧面後限制解除，不反向新增霧面喜好",
