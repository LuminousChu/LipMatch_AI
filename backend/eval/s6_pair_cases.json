     "expect": {"disliked_finishes": [], "liked_finishes": [], "conflicts": 0}},
    {"id": "P03", "spec": "R06", "title": "「霧面也可以」視為取消排斥",
     "steps": ["不要霧面", "霧面也可以"],
     "expect": {"disliked_finishes": [], "liked_finishes": []}},
    {"id": "P04", "spec": "R13", "title": "未回答過敏不變成無已知",
