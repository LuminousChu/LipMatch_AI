# 複製為 .env 後填值；.env 不進 git。本檔不含任何真實秘密。
# 隨機密碼可用：python -c "import secrets;print(secrets.token_urlsafe(32))"

# ===== 隔離 =====
# 同一台電腦跑多份時各用不同名稱，避免共用測試 DB（容器與 volume 會以此為前綴）
COMPOSE_PROJECT_NAME=lipmatch

# ===== 連接埠（只綁 127.0.0.1；同時跑多份時要錯開）=====
FRONTEND_PORT=8280
BACKEND_PORT=8200

# ===== 資料庫 =====
# POSTGRES_*：資料庫管理帳號，只給 db 容器初始化使用
POSTGRES_USER=lipmatch
POSTGRES_PASSWORD=
POSTGRES_DB=lipmatch
# 後端專用帳號（非超級使用者）；密碼與管理帳號不同
APP_DB_USER=lipmatch_app
APP_DB_PASSWORD=

# ===== 後端 =====
SESSION_TTL_HOURS=12
# 本機 http 用 false；遠端 HTTPS 必須改為 true（cookie 才會加 Secure 並使用 __Host- 前綴）
SESSION_COOKIE_SECURE=false
# 允許發出修改請求的來源，需與 FRONTEND_PORT 一致；遠端部署改成實際的 https 網址
APP_ORIGINS=http://127.0.0.1:8280,http://localhost:8280
# 登入失敗限制：同一帳號連續失敗次數、同一來源 IP 失敗次數、時間窗（分鐘）
LOGIN_MAX_FAILURES_PER_USER=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_WINDOW_MINUTES=15

# ===== 模型（尚未使用，型號與帳戶未定，見 docs/mvp/architecture.md）=====
# 生成模型與嵌入模型決定後才加入；不要先填真實金鑰。

# ---- 模型服務（docker-compose.models.yml 使用；llama.cpp llama-server 的 OpenAI 相容 API）----
# 嵌入：xVITA-Embed-300M-zhTW，例如在主機以 llama-server --embeddings --port 8099 啟動
EMBEDDING_BASE_URL=http://host.docker.internal:8099
EMBEDDING_MODEL_SHA256=
# 生成：gemma-4-12B-it Q4_K_M 的 llama-server 位址與金鑰（可在本機 GPU 或遠端主機）
GENERATION_BASE_URL=
GENERATION_API_KEY=
